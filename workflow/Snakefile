
include: "rules/common.smk"
include: "rules/reference.smk"
include: "rules/align.smk"
include: "rules/cram.smk"
include: "rules/call.smk"
include: "rules/qc.smk"


rule all:
    input:
        expand(
            [
                f"{OUTDIR}/{{sample}}/cross_check_fingerprints/{{sample}}.metrics",
                f"{OUTDIR}/{{sample}}/check_contamination/{{sample}}.preBqsr.selfSM",
                f"{OUTDIR}/{{sample}}/collect_readgroup_bam_quality_metrics/{{sample}}.alignment_summary_metrics",
                f"{OUTDIR}/{{sample}}/calculate_readgroup_checksum/{{sample}}.bam.md5",
                f"{OUTDIR}/{{sample}}/collect_wgs_metrics/{{sample}}.wgs_metrics",
                f"{OUTDIR}/{{sample}}/collect_raw_wgs_metrics/{{sample}}.raw_wgs_metrics",
                f"{OUTDIR}/{{sample}}/validate_sam_file/{{sample}}.validation_report",
                f"{OUTDIR}/{{sample}}/validate_gvcf/{{sample}}.OK",
                f"{OUTDIR}/{{sample}}/collect_variant_calling_metrics/{{sample}}.variant_calling_summary_metrics",
            ],
            sample=SAMPLES,
        ),
        lambda w: [
            f"{OUTDIR}/{sample}/{step}/{read_group}.{suffix}"
            for sample in SAMPLES
            for read_group in read_groups(sample)
            for step, suffix in [
                ("collect_quality_yield_metrics", "metrics"),
                ("collect_unsorted_readgroup_bam_quality_metrics", "insert_size_metrics"),
            ]
        ],
